+#ifndef RB4DX_PRESENT_LAYOUT_H
+#define RB4DX_PRESENT_LAYOUT_H
+#include <vulkan/vulkan.h>
+
+/* This server implements virtual X11 swapchains with ordinary imported AHB
+ * images. PRESENT is not a legal real-image layout. The guest's final render
+ * barrier becomes GENERAL; the separate present submission releases ownership.
+ * Deserialized barrier storage is owned and mutable for the current request. */
+static inline VkImageLayout rb4dxPresentLayout(VkImageLayout layout) {
+    return layout == VK_IMAGE_LAYOUT_PRESENT_SRC_KHR ? VK_IMAGE_LAYOUT_GENERAL : layout;
+}
+static inline void rb4dxPresentBarriers(uint32_t count, VkImageMemoryBarrier* barriers) {
+    for (uint32_t i = 0; i < count; i++) {
+        barriers[i].oldLayout = rb4dxPresentLayout(barriers[i].oldLayout);
+        barriers[i].newLayout = rb4dxPresentLayout(barriers[i].newLayout);
+    }
+}
+static inline void rb4dxPresentDependency(VkDependencyInfo* info) {
+    VkImageMemoryBarrier2* barriers = (VkImageMemoryBarrier2*)info->pImageMemoryBarriers;
+    for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+        barriers[i].oldLayout = rb4dxPresentLayout(barriers[i].oldLayout);
+        barriers[i].newLayout = rb4dxPresentLayout(barriers[i].newLayout);
+    }
+}
+#endif
